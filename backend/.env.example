# Plantilla. Copia a backend/.env para desarrollo (.env está en .gitignore y
# nunca se sube). En Railway estas mismas claves se definen como Variables del
# servicio, no con un fichero.
#
# Sin .env, settings.py aplica sus valores por defecto, que son de desarrollo.

# Mínimo 32 bytes: SimpleJWT firma los tokens con HS256 a partir de esta clave.
# Generar:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=genera-un-valor-largo-y-aleatorio-de-al-menos-32-bytes

DEBUG=False

# Dominios que responde Django. En Railway no hace falta: settings.py añade
# solo RAILWAY_PUBLIC_DOMAIN. Rellénalo al poner un dominio propio.
ALLOWED_HOSTS=example.com,www.example.com

# Sólo importa si algún día separas frontend y backend en dos dominios. Con el
# despliegue de un único servicio todo es mismo origen y CORS no interviene.
CORS_ALLOWED_ORIGINS=https://example.com

# Necesario para el login del admin de Django tras un dominio propio.
CSRF_TRUSTED_ORIGINS=https://example.com

TIME_ZONE=Europe/Madrid
BOOKING_DAYS_AHEAD=7

# La define el plugin de Postgres de Railway. Si falta, se usa SQLite local.
# DATABASE_URL=postgresql://user:pass@host:5432/railway
